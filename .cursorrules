# Next.js Full-Stack Application Rules & Guidelines

## 1. Tech Stack & Core Services

- **Framework**: Next.js 15 (App Router)
- **Frontend**: React, TypeScript, Tailwind CSS, shadcn/ui
- **Backend**: Next.js API Routes (Server-side)
- **Database**: MongoDB with Mongoose ODM
- **Authentication**: JWT (JSON Web Tokens)
- **Validation**: Zod for runtime type validation
- **State Management**: React Context + React Query/SWR
- **Testing**: Jest, React Testing Library, Playwright

## 2. Clean Architecture Principles

### Folder Structure

```
/src
  /app                    # Next.js App Router
    /api                  # API Routes
    /(auth)              # Auth group routes
    /(dashboard)         # Protected routes
    /layout.tsx
    /page.tsx
  
  /core                   # Business Logic Layer (Domain)
    /entities            # Domain entities/models
    /use-cases           # Business logic/application services
    /repositories        # Repository interfaces
    /errors              # Custom error classes
  
  /infrastructure         # External Services Layer
    /database
      /mongodb           # MongoDB connection & models
      /repositories      # Repository implementations
    /auth                # Authentication implementations
    /external-services   # Third-party API integrations
  
  /presentation           # Presentation Layer
    /components
      /ui                # shadcn/ui components
      /features          # Feature-specific components
      /layouts           # Layout components
    /hooks               # Custom React hooks
    /contexts            # React Context providers
  
  /lib                    # Shared Utilities
    /api-client          # API client wrapper
    /validators          # Zod schemas
    /utils               # Helper functions
    /constants           # App constants
  
  /types                  # TypeScript type definitions
  /config                 # Configuration files
```

### Layer Responsibilities

1. **Domain Layer (Core)**
   - Pure business logic
   - No framework dependencies
   - Entity definitions
   - Use case implementations
   - Repository interfaces

2. **Infrastructure Layer**
   - Database implementations
   - External API integrations
   - Authentication mechanisms
   - File storage services

3. **Presentation Layer**
   - React components
   - UI state management
   - User interactions
   - Client-side routing

4. **API Layer (Next.js Routes)**
   - HTTP request/response handling
   - Route definitions
   - Middleware integration
   - Input validation

## 3. Professional Coding Standards

### TypeScript Standards

- **Strict Mode**: Always use `"strict": true` in tsconfig.json
- **Type Everything**: No implicit `any` types
- **Interface First**: Define interfaces for all data structures
- **Proper Typing**: Use generics, utility types, and type guards

```typescript
// ✅ Good - Explicit typing
interface User {
  id: string
  email: string
  name: string
  role: 'admin' | 'user'
  createdAt: Date
}

async function getUser(id: string): Promise<User> {
  // Implementation
}

// ❌ Bad - Implicit any
async function getUser(id) {
  // Implementation
}
```

### Naming Conventions

- **Files**: kebab-case (`user-service.ts`, `auth-middleware.ts`)
- **Components**: PascalCase (`UserProfile.tsx`, `DashboardLayout.tsx`)
- **Functions/Variables**: camelCase (`getUserById`, `isAuthenticated`)
- **Constants**: UPPER_SNAKE_CASE (`API_BASE_URL`, `MAX_RETRIES`)
- **Interfaces/Types**: PascalCase (`UserDTO`, `ApiResponse<T>`)
- **Private methods**: Prefix with underscore (`_validateToken`)

### Code Organization

- **Single Responsibility**: One class/function = one responsibility
- **DRY Principle**: Extract reusable logic into utilities
- **SOLID Principles**: Follow SOLID design patterns
- **Dependency Injection**: Use DI for better testability
- **Error Handling**: Centralized error handling strategy

## 4. Authentication Implementation

### JWT Authentication Flow

```typescript
// /src/core/use-cases/auth/authenticate-user.ts
export class AuthenticateUser {
  constructor(
    private userRepository: IUserRepository,
    private tokenService: ITokenService
  ) {}

  async execute(email: string, password: string): Promise<AuthResult> {
    // 1. Validate input
    const validation = authSchema.safeParse({ email, password })
    if (!validation.success) throw new ValidationError(validation.error)

    // 2. Find user
    const user = await this.userRepository.findByEmail(email)
    if (!user) throw new AuthenticationError('Invalid credentials')

    // 3. Verify password
    const isValid = await this.tokenService.verifyPassword(password, user.password)
    if (!isValid) throw new AuthenticationError('Invalid credentials')

    // 4. Generate tokens
    const accessToken = await this.tokenService.generateAccessToken(user)
    const refreshToken = await this.tokenService.generateRefreshToken(user)

    return { accessToken, refreshToken, user }
  }
}
```

### API Route Authentication

```typescript
// /src/app/api/auth/login/route.ts
import { NextRequest, NextResponse } from 'next/server'
import { AuthenticateUser } from '@/core/use-cases/auth/authenticate-user'
import { handleApiError } from '@/lib/utils/error-handler'

export async function POST(request: NextRequest) {
  try {
    const body = await request.json()
    
    // Dependency injection
    const authenticateUser = new AuthenticateUser(
      userRepository,
      tokenService
    )
    
    const result = await authenticateUser.execute(body.email, body.password)
    
    // Set httpOnly cookie
    const response = NextResponse.json({
      success: true,
      data: { user: result.user }
    })
    
    response.cookies.set('accessToken', result.accessToken, {
      httpOnly: true,
      secure: process.env.NODE_ENV === 'production',
      sameSite: 'strict',
      maxAge: 60 * 60 // 1 hour
    })
    
    response.cookies.set('refreshToken', result.refreshToken, {
      httpOnly: true,
      secure: process.env.NODE_ENV === 'production',
      sameSite: 'strict',
      maxAge: 60 * 60 * 24 * 7 // 7 days
    })
    
    return response
  } catch (error) {
    return handleApiError(error)
  }
}
```

### Middleware Authentication

```typescript
// /src/middleware.ts
import { NextResponse } from 'next/server'
import type { NextRequest } from 'next/server'
import { verifyJWT } from '@/lib/auth/jwt'

export async function middleware(request: NextRequest) {
  const token = request.cookies.get('accessToken')?.value
  
  // Protected routes
  if (request.nextUrl.pathname.startsWith('/dashboard')) {
    if (!token) {
      return NextResponse.redirect(new URL('/login', request.url))
    }
    
    try {
      const payload = await verifyJWT(token)
      
      // Add user to headers for API routes
      const requestHeaders = new Headers(request.headers)
      requestHeaders.set('x-user-id', payload.userId)
      requestHeaders.set('x-user-role', payload.role)
      
      return NextResponse.next({
        request: {
          headers: requestHeaders,
        },
      })
    } catch (error) {
      return NextResponse.redirect(new URL('/login', request.url))
    }
  }
  
  return NextResponse.next()
}

export const config = {
  matcher: ['/dashboard/:path*', '/api/:path*']
}
```

## 5. API Development Standards

### API Route Pattern

```typescript
// Standard API route structure
import { NextRequest, NextResponse } from 'next/server'
import { z } from 'zod'

// 1. Define validation schema
const requestSchema = z.object({
  name: z.string().min(1),
  email: z.string().email()
})

// 2. Implement handler with proper error handling
export async function POST(request: NextRequest) {
  try {
    // Authenticate
    const userId = request.headers.get('x-user-id')
    if (!userId) {
      return NextResponse.json(
        { error: 'Unauthorized' },
        { status: 401 }
      )
    }
    
    // Validate input
    const body = await request.json()
    const validatedData = requestSchema.parse(body)
    
    // Execute use case
    const useCase = new CreateUserUseCase(userRepository)
    const result = await useCase.execute(validatedData)
    
    // Return response
    return NextResponse.json({
      success: true,
      data: result
    }, { status: 201 })
    
  } catch (error) {
    if (error instanceof z.ZodError) {
      return NextResponse.json(
        { error: 'Validation failed', details: error.errors },
        { status: 400 }
      )
    }
    
    console.error('API Error:', error)
    return NextResponse.json(
      { error: 'Internal server error' },
      { status: 500 }
    )
  }
}
```

### Consistent Response Format

```typescript
// /src/types/api.ts
export interface ApiResponse<T = any> {
  success: boolean
  data?: T
  error?: string
  message?: string
  meta?: {
    page?: number
    limit?: number
    total?: number
  }
}

// Success response helper
export function successResponse<T>(
  data: T,
  message?: string,
  meta?: any
): ApiResponse<T> {
  return {
    success: true,
    data,
    message,
    meta
  }
}

// Error response helper
export function errorResponse(
  error: string,
  statusCode: number = 500
): NextResponse {
  return NextResponse.json(
    {
      success: false,
      error
    },
    { status: statusCode }
  )
}
```

## 6. Database Integration

### MongoDB Connection

```typescript
// /src/infrastructure/database/mongodb/connection.ts
import mongoose from 'mongoose'

const MONGODB_URI = process.env.MONGODB_URI!

if (!MONGODB_URI) {
  throw new Error('Please define MONGODB_URI environment variable')
}

let cached = global.mongoose

if (!cached) {
  cached = global.mongoose = { conn: null, promise: null }
}

export async function connectDB() {
  if (cached.conn) {
    return cached.conn
  }

  if (!cached.promise) {
    const opts = {
      bufferCommands: false,
    }

    cached.promise = mongoose.connect(MONGODB_URI, opts).then((mongoose) => {
      return mongoose
    })
  }

  try {
    cached.conn = await cached.promise
  } catch (e) {
    cached.promise = null
    throw e
  }

  return cached.conn
}
```

### Repository Pattern

```typescript
// /src/core/repositories/user-repository.interface.ts
export interface IUserRepository {
  findById(id: string): Promise<User | null>
  findByEmail(email: string): Promise<User | null>
  create(data: CreateUserDTO): Promise<User>
  update(id: string, data: UpdateUserDTO): Promise<User>
  delete(id: string): Promise<void>
}

// /src/infrastructure/database/repositories/user-repository.ts
import { IUserRepository } from '@/core/repositories/user-repository.interface'
import UserModel from '../mongodb/models/user-model'

export class UserRepository implements IUserRepository {
  async findById(id: string): Promise<User | null> {
    const user = await UserModel.findById(id).lean()
    return user ? this.toDomain(user) : null
  }

  async findByEmail(email: string): Promise<User | null> {
    const user = await UserModel.findOne({ email }).lean()
    return user ? this.toDomain(user) : null
  }

  async create(data: CreateUserDTO): Promise<User> {
    const user = await UserModel.create(data)
    return this.toDomain(user)
  }

  async update(id: string, data: UpdateUserDTO): Promise<User> {
    const user = await UserModel.findByIdAndUpdate(id, data, { new: true })
    if (!user) throw new NotFoundError('User not found')
    return this.toDomain(user)
  }

  async delete(id: string): Promise<void> {
    await UserModel.findByIdAndDelete(id)
  }

  private toDomain(model: any): User {
    return {
      id: model._id.toString(),
      email: model.email,
      name: model.name,
      role: model.role,
      createdAt: model.createdAt,
      updatedAt: model.updatedAt
    }
  }
}
```

## 7. Frontend Development

### Component Standards

```typescript
// /src/presentation/components/features/user-profile/UserProfile.tsx
'use client'

import { useState } from 'react'
import { useQuery, useMutation } from '@tanstack/react-query'
import { Button } from '@/presentation/components/ui/button'
import { Card, CardContent, CardHeader, CardTitle } from '@/presentation/components/ui/card'
import { apiClient } from '@/lib/api-client'
import type { User } from '@/types/user'

interface UserProfileProps {
  userId: string
}

/**
 * User profile component displaying user information
 * @param userId - The ID of the user to display
 */
export function UserProfile({ userId }: UserProfileProps) {
  const [isEditing, setIsEditing] = useState(false)

  // Fetch user data
  const { data: user, isLoading, error } = useQuery<User>({
    queryKey: ['user', userId],
    queryFn: () => apiClient.get(`/api/users/${userId}`)
  })

  // Update user mutation
  const updateMutation = useMutation({
    mutationFn: (data: Partial<User>) => 
      apiClient.put(`/api/users/${userId}`, data),
    onSuccess: () => {
      setIsEditing(false)
      // Invalidate and refetch
      queryClient.invalidateQueries(['user', userId])
    }
  })

  if (isLoading) return <div>Loading...</div>
  if (error) return <div>Error loading user</div>
  if (!user) return <div>User not found</div>

  return (
    <Card>
      <CardHeader>
        <CardTitle>{user.name}</CardTitle>
      </CardHeader>
      <CardContent>
        <p>{user.email}</p>
        <Button onClick={() => setIsEditing(true)}>
          Edit Profile
        </Button>
      </CardContent>
    </Card>
  )
}
```

